# Set these in Vercel → Project → Settings → Environment Variables. They are read on the server only.
# None of them is ever sent to the browser.

# Option A: email enquiries through Resend (resend.com)
RESEND_API_KEY=
ENQUIRY_FROM="Ryan McGinty Interiors <enquiries@your-verified-domain.co.uk>"
ENQUIRY_TO=ryan@ryanmcgintyinteriors.co.uk

# Option B: forward enquiries to Formspree or any webhook
FORM_ENDPOINT=

# Optional: live Instagram posts (JSON feed URL)
INSTAGRAM_FEED_URL=
